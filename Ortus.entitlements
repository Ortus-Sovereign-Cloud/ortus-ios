<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Invitation links of these installations open the app (their
       /.well-known/apple-app-site-association names it). -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:ortus.cc</string>
    <!-- The shared app link of every installation's invitations. -->
    <string>applinks:join.ortus.cc</string>
  </array>
  <!-- Notifications while the app is closed (Apple's push service). -->
  <key>aps-environment</key>
  <string>development</string>
  <!-- The app's own group first (where the session and key stay), then
       the one it shares with the notification extension. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)cc.ortus.app</string>
    <string>$(AppIdentifierPrefix)cc.ortus.shared</string>
  </array>
  <!-- An organisation's device management may add its own domains. -->
  <key>com.apple.developer.associated-domains.mdm-managed</key>
  <true/>
</dict>
</plist>
