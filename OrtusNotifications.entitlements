<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The fetch tokens the app keeps for this extension (Shared/PushStore). -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)cc.ortus.shared</string>
  </array>
</dict>
</plist>
